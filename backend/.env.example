# Knowly 2.0 — Backend Environment Configuration
# Copy to .env and fill in your values

# === Application ===
ENVIRONMENT=development
PROJECT_NAME=Knowly 2.0

# === Database ===
# SQLite (default, dev): DATABASE_URL=sqlite:///./knowly.db
# PostgreSQL (prod/docker): postgresql://knowly:knowly_dev_password@postgres:5432/knowly
DATABASE_URL=sqlite:///./knowly.db

# === Vector DB & Cache ===
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# === LLM API Keys (at least one required for real responses) ===
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# Groq:      https://console.groq.com/keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# === Model Selection ===
DEFAULT_FAST_MODEL=groq/llama-3.3-70b-versatile
DEFAULT_REASONING_MODEL=openai/gpt-4o
DEFAULT_COMPLEX_MODEL=anthropic/claude-3-5-sonnet

# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED in production. Auto-generated in dev if blank.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === CORS (comma-separated origins) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# === Storage ===
STORAGE_DIR=./storage

# === Background Tasks ===
# Max retries for failed background tasks
TASK_MAX_RETRIES=3
# Min interval between retries (seconds)
TASK_RETRY_MIN_DELAY=10

# === Docker / Deployment ===
# Port the backend listens on inside the container (default: 8000)
BACKEND_PORT=8000
# Set to 'production' to disable CORS wildcard and debug endpoints
DEPLOY_ENV=development
